NEXT_PUBLIC_MEDIAMTX_URL=http://localhost:8889

# Chave privada usada apenas pelos Route Handlers para emitir tokens Ably.
# Crie um app em https://ably.com e nunca exponha esta chave ao navegador.
ABLY_API_KEY=

# Necessário apenas caso queira acessar o next dev
# através de outro hostname/IP na rede local.
DEV_ALLOWED_ORIGIN=
